    "You may not have permission to write to that location, or the disk is read-only. Choose another location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Möglicherweise hast du keine Schreibberechtigung für diesen Ort oder das Laufwerk ist schreibgeschützt. Wähle einen anderen Speicherort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puede que no tengas permiso para escribir en esa ubicación o que el disco sea de solo lectura. Elige otra ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous n’avez peut-être pas l’autorisation d’écrire à cet emplacement, ou le disque est en lecture seule. Choisissez un autre emplacement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "その場所への書き込み権限がないか、ディスクが読み出し専用になっている可能性があります。別の場所を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "해당 위치에 쓸 수 있는 권한이 없거나 디스크가 읽기 전용일 수 있습니다. 다른 위치를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Talvez você não tenha permissão para gravar nesse local ou o disco seja somente leitura. Escolha outro local."
