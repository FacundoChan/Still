{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ You can also export the files and import them into Photos yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Du kannst die Dateien auch exportieren und selbst in „Fotos“ importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ También puedes exportar los archivos e importarlos a Fotos por tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Vous pouvez aussi exporter les fichiers et les importer vous-même dans Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ファイルを書き出して、ご自身で“写真”に読み込むこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 파일을 내보낸 다음 사진 앱으로 직접 가져올 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Você também pode exportar os arquivos e importá-los manualmente para o app Fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@你也可以导出文件，然后自行导入“照片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@你也可以輸出檔案，再自行匯入「照片」。"
          }
        }
      }
    },
