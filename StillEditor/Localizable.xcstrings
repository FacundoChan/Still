    "%@ You can also share the video instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Du kannst das Video stattdessen auch teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ También puedes compartir el video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Vous pouvez aussi partager la vidéo à la place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@代わりにビデオを共有することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 대신 비디오를 공유할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Você também pode compartilhar o vídeo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@你也可以改为共享视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@你也可以改為分享影片。"
          }
        }
      }
    },
    "Allow Still in System Settings › Privacy & Security › Photos." : {
      "comment" : "macOS: where to grant the Photos permission",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube Still den Zugriff unter Systemeinstellungen › Datenschutz & Sicherheit › Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Still in System Settings › Privacy & Security › Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a Still en Ajustes del Sistema › Privacidad y seguridad › Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez Still dans Réglages Système › Confidentialité et sécurité › Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“システム設定”>“プライバシーとセキュリティ”>“写真”で、Stillを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 사진에서 Still을 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso do Still em Ajustes do Sistema › Privacidade e Segurança › Fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在“系统设置”›“隐私与安全性”›“照片”中允许 Still 访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請在「系統設定」›「隱私權與安全性」›「照片」中允許 Still。"
          }
        }
      }
    },
    "Allow Still to add photos in Settings › Apps › Still › Photos." : {
      "comment" : "iOS: where to grant the Photos permission",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube Still das Hinzufügen von Fotos unter Einstellungen › Apps › Still › Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Still to add photos in Settings › Apps › Still › Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ve a Ajustes › Apps › Still › Fotos y permite que Still añada fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez Still à ajouter des photos dans Réglages › Apps › Still › Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“設定”>“アプリ”>“Still”>“写真”で、Stillによる写真の追加を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "설정 › 앱 › Still › 사진에서 Still이 사진을 추가할 수 있도록 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita que o Still adicione fotos em Ajustes › Apps › Still › Fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在“设置”›“App”›“Still”›“照片”中允许 Still 添加照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請在「設定」›「App」›「Still」›「照片」中允許 Still 加入照片。"
          }
        }
